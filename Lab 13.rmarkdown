```{r}
library(tidyverse)
library(janitor)
library(igraph)
library(ggraph)
library(viridis)

# Load and clean data
soilMAGs <- read_csv("NEON_soilMAGs_soilChem.csv", show_col_types = FALSE) %>%
  clean_names()

# Count MAGs per genus per site
taxa_counts <- soilMAGs %>%
  filter(!is.na(genus), genus != "") %>%
  group_by(site, genus) %>%
  summarize(count = n(), .groups = "drop")

# Relative abundance per site
taxa_abundance <- taxa_counts %>%
  group_by(site) %>%
  mutate(rel_abund = count / sum(count)) %>%
  ungroup()

# Wide community matrix
comm_matrix <- taxa_abundance %>%
  pivot_wider(names_from = genus, values_from = rel_abund, values_fill = 0)

comm_matrix <- column_to_rownames(comm_matrix, var = "site")
comm_matrix <- as.data.frame(comm_matrix)
comm_matrix[] <- lapply(comm_matrix, as.numeric)

```

```{r}
# Spearman correlation between taxa
cor_mat <- cor(comm_matrix, method = "spearman")

# Threshold for significant co-occurrence
cor_threshold <- 0.6
adj_mat <- (cor_mat > cor_threshold) * 1
diag(adj_mat) <- 0

```

```{r}
net <- graph_from_adjacency_matrix(adj_mat, mode = "undirected", diag = FALSE)
V(net)$name <- colnames(comm_matrix)

# Plot network
set.seed(42)
ggraph(net, layout = "fr") +
  geom_edge_link(alpha = 0.3) +
  geom_node_point(color = "steelblue", size = 5) +
  geom_node_text(aes(label = name), repel = TRUE, size = 3) +
  theme_void() +
  labs(title = "Microbial Co-occurrence Network")

```

```{r}
modules <- cluster_louvain(net)
V(net)$module <- modules$membership

# Visualize modules
ggraph(net, layout = "fr") +
  geom_edge_link(alpha = 0.2) +
  geom_node_point(aes(color = factor(module)), size = 5) +
  geom_node_text(aes(label = name), repel = TRUE, size = 3) +
  scale_color_viridis(discrete = TRUE) +
  theme_void() +
  labs(title = "Detected Modules in Microbial Network", color = "Module")

```

